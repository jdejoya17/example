# colors for echo output
BOLD=\033[1m
LIGHT_BLUE=\033[36m
NC=\033[0m
RED=\033[91m

# openapi specification env variables
OPENAPI_SPEC_BASE_DIR=openapi

TOOL_CONFIGS_BASE_DIR=${OPENAPI_SPEC_BASE_DIR}/tool-configs
INTERMEDIATE_OPENAPI_SPEC=${TOOL_CONFIGS_BASE_DIR}/intermediate.yaml
OPENAPI_SPEC_MERGE_CONFIG=${TOOL_CONFIGS_BASE_DIR}/merge-config.yaml
OPENAPI_SERVER_GENERATOR_CONFIG=${TOOL_CONFIGS_BASE_DIR}/generator-config.yaml

OPENAPI_IGNORE_FILE=.openapi-generator-ignore
OPENAPI_GENERATOR_META=.openapi-generator
